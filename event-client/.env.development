# Same-origin path: the Vite dev proxy forwards /api to http://localhost:5000.
# In production IIS rewrites /api on the event subdomain to the shared backend,
# so the app never needs an absolute API host.
VITE_API_URL=/api

# Local only: reuses the staff OAuth client so sign-in works without extra setup.
# Production needs its own client with an External consent screen, so general
# Gmail accounts can sign in (this one is restricted to the ksrct.ac.in domain).
#
# NOTE: add http://localhost:3001 to this client's Authorized JavaScript origins
# in the Google Cloud console, otherwise Google blocks the sign-in popup.
VITE_GOOGLE_CLIENT_ID=640936577113-6lvhmv5u1g7f79a39m97j48vclfgrhem.apps.googleusercontent.com
