# API base path. Dev: proxied to :5000 by vite.config.ts. Prod: same-origin /api.
VITE_API_URL=/api

# Google OAuth client for public participant sign-in.
# Production must use a client with an External consent screen so any Gmail
# account can sign in. Locally you can reuse the staff client id.
VITE_GOOGLE_CLIENT_ID=
