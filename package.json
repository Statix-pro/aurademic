{
  "name": "aurademic-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:client": "npm install --prefix client",
    "install:event": "npm install --prefix event-client",
    "install:server": "npm install --prefix server",
    "install:all": "npm run install:server && npm run install:client && npm run install:event",
    "postinstall": "npm run install:all",
    "dev:client": "npm run dev --prefix client",
    "dev:event": "npm run dev --prefix event-client",
    "dev:server": "npm run dev --prefix server",
    "dev": "concurrently -n server,client,event -c blue,green,magenta \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:event\"",
    "dev:staff": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:public": "concurrently -n server,event -c blue,magenta \"npm run dev:server\" \"npm run dev:event\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:client": "eslint client",
    "lint:event": "eslint event-client",
    "lint:server": "eslint server",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "npm run typecheck:client && npm run typecheck:event",
    "typecheck:client": "npm run typecheck --prefix client",
    "typecheck:event": "npm run typecheck --prefix event-client",
    "check:server": "find server -path 'server/node_modules' -prune -o \\( -name '*.js' -o -name '*.cjs' \\) -print0 | xargs -0 -n1 node --check",
    "test:server": "npm test --prefix server",
    "reconcile:budget-annual": "npm run reconcile:budget-annual --prefix server --",
    "build": "npm run build:client && npm run build:event",
    "build:client": "npm run build --prefix client",
    "build:event": "npm run build --prefix event-client",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,mdx,yml,yaml,css,scss,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.60.1"
  }
}
