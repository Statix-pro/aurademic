<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>

        <!-- 1. iisnode Handler: Tells IIS to use iisnode for the backend entry file -->
        <handlers>
            <!-- Remove any existing iisnode handler to avoid conflicts -->
            <remove name="iisnode" />
            <!-- Add the handler pointing to your backend server.js -->
            <!-- The 'path' is relative to the location of THIS web.config -->
            <add name="iisnode" path="server/server.js" verb="*" modules="iisnode" />
        </handlers>

        <!-- 2. URL Rewrite Rules -->
        <rewrite>
            <rules>
                <!-- Rule 1: Route API calls to Node.js backend -->
                <!-- It matches URLs starting with 'api/' -->
                <rule name="NodeJS Backend API" stopProcessing="true">
                    <match url="^api/(.*)" ignoreCase="true" />
                    <!-- Rewrite the URL to the Node.js entry point -->
                    <!-- The actual API path (e.g., /users) is available inside Node via req.url -->
                    <action type="Rewrite" url="server/server.js" />
                    <!-- NOTE: You might need URL Rewrite ARR Helper installed -->
                    <!-- If headers like host are needed by Node, uncomment serverVariables below -->
                    <!-- <serverVariables>
                        <set name="HTTP_X_ORIGINAL_HOST" value="{HTTP_HOST}" />
                    </serverVariables> -->
                </rule>

                <!-- Rule 2: Serve React App (Handle client-side routing) -->
                <!-- This rule ensures that requests that aren't for existing files/directories -->
                <!-- and aren't API calls get directed to your React app's index.html -->
                <rule name="ReactApp Routes" stopProcessing="true">
                    <match url=".*" />
                    <conditions logicalGrouping="MatchAll">
                        <!-- Condition 1: Is the request NOT for a physical file? -->
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                        <!-- Condition 2: Is the request NOT for a physical directory? -->
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                        <!-- Condition 3: Is the request NOT an API call (already handled)? -->
                        <add input="{REQUEST_URI}" pattern="^/api/" negate="true" />
                    </conditions>
                    <!-- Rewrite to the root index.html of your React app -->
                    <action type="Rewrite" url="index.html" />
                     <!-- If your react build is in a subfolder like 'build', change url to '/build/index.html' -->
                </rule>
            </rules>
        </rewrite>

        <!-- 3. Optional: iisnode configuration (Logging is useful!) -->
        <iisnode
      node_env="production"
      loggingEnabled="true"
      devErrorsEnabled="true"  
      debuggingEnabled="true"
      logDirectory="iisnode_logs"  
      nodeProcessCommandLine="C:\nodejs\node.exe"
    />

        <!-- 4. Optional: Security - Hide node_modules folders -->
        <security>
          <requestFiltering>
            <hiddenSegments>
              <add segment="node_modules" />
              <!-- <add segment="server/node_modules" /> -->
            </hiddenSegments>
          </requestFiltering>
        </security>

    </system.webServer>
</configuration>