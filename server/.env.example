# ==========================================================================
# Backend environment — copy to .env.development (and .env.production)
# ==========================================================================
#
#   cp .env.example .env.development
#
# config/env.js loads .env.production when NODE_ENV=production and
# .env.development otherwise. It resolves the path from process.cwd(), so the
# server must be started from the `server/` directory — `npm run dev` and
# `npm start` both do.
#
# Every variable below is read by the code. Keep this file in sync when you add
# a new one.
# ==========================================================================

# --- Server ---------------------------------------------------------------
PORT=5000
# 'production' switches config/env.js to .env.production, disables Swagger UI,
# and narrows CORS to FRONTEND_URL.
NODE_ENV=development

# --- Database -------------------------------------------------------------
# MySQL 8.x. config/connection.js builds a pool with a limit of 10.
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=research
# NOTE: there is no DB_PORT. connection.js does not read one, so MySQL's
# default 3306 always applies. A non-standard port needs a code change.

# --- Auth -----------------------------------------------------------------
# Signs every session JWT. Use a long random value — anyone holding it can mint
# a token for any user. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_me_with_a_long_random_secret

# Google OAuth client id, used server-side to verify the ID token from the
# browser. Must match the client's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Where the SPA is served from. In production this is the only allowed CORS
# origin; in development localhost:3000 is allowed regardless.
FRONTEND_URL=http://localhost:3000

# --- Notifications: Web Push (optional) -----------------------------------
# In-app notifications work without these. When the keys are absent the push
# channel reports itself disabled and its deliveries record 'skipped', so
# nothing breaks and nothing is retried.
#
# Generate a pair with:  npx web-push generate-vapid-keys
# Use a DIFFERENT pair per environment — sharing one private key means a
# compromised dev machine can push to every production user.
#
# The PUBLIC key is served to browsers at GET /api/notifications/push/public-key,
# which is why the frontend needs no VAPID variable of its own.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Must be a mailto: or https: URL — the push services reject anything else.
VAPID_SUBJECT=mailto:noreply@ksrct.ac.in

# --- Notifications: outbox dispatcher -------------------------------------
# false runs the API with delivery paused. Emits keep accumulating harmlessly
# in notification_events and are delivered once this is switched back on.
NOTIFICATIONS_DISPATCH_ENABLED=true
# How often the outbox worker sweeps, in milliseconds. Minimum 1000.
NOTIFICATIONS_DISPATCH_INTERVAL_MS=10000
# Safety cap on how many people a single event may notify. Exceeding it logs a
# warning and truncates, rather than writing thousands of rows.
NOTIFICATIONS_MAX_RECIPIENTS=500
