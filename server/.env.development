# --- Public event site (event-client) ---
# Blank locally: config/participantAuth.js falls back to GOOGLE_CLIENT_ID above.
# Production needs its own client with an External consent screen so general
# Gmail accounts can sign in.
GOOGLE_PARTICIPANT_CLIENT_ID=
# Blank locally: falls back to JWT_SECRET. REQUIRED in production, where the app
# refuses to sign participant tokens with the staff secret.
JWT_PARTICIPANT_SECRET=

# --- Notifications ---
# Web Push (VAPID). In-app notifications work without these; when they are
# absent the push channel reports itself disabled and deliveries record
# 'skipped'. Regenerate with: npx web-push generate-vapid-keys
# The PUBLIC key is served to browsers at GET /api/notifications/push/public-key,
# so the client needs no VITE_ variable of its own.
VAPID_PUBLIC_KEY=BAYyvHW_TY4wSCKUeSm1VHYTbUkSqIPEy0QR7XiPuioekVQIjCNAlmwqGMhQNkRewdGiq86RwFEEgjA2Huyn0Rg
VAPID_PRIVATE_KEY=2d7jEId3CEhn7Qs0-dTZblYVl_nyNrmXNJZrLMWpCSQ
VAPID_SUBJECT=mailto:noreply@ksrct.ac.in

# Set to false to run the API with notification delivery paused. Emits keep
# accumulating harmlessly in the outbox and are delivered once re-enabled.
NOTIFICATIONS_DISPATCH_ENABLED=true
# How often the outbox worker sweeps, in milliseconds.
NOTIFICATIONS_DISPATCH_INTERVAL_MS=10000
