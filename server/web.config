<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <!-- First, remove any inherited rule for this segment -->
          <remove segment="node_modules" /> 
          <!-- Then, add the rule specifically for this folder -->
          <add segment="node_modules" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <!-- You might have other settings here later -->
  </system.webServer>
</configuration>