# ==========================================================================
# Frontend environment — copy to .env.development (and .env.production)
# ==========================================================================
#
#   cp .env.example .env.development
#
# Vite only exposes variables prefixed VITE_ to the browser bundle. Everything
# here therefore ships to the client and is publicly visible — never put a
# secret in this file. OAuth *client ids* are safe (they are public by design);
# client *secrets* and signing keys are not and belong in the backend env.
#
# Every variable below is read by the code. Keep this file in sync when you add
# a new one.
# ==========================================================================

# --- API ------------------------------------------------------------------
# Base URL including the /api suffix. Read once, in
# src/shared/utils/authenticityUtility.ts.
VITE_API_URL=http://localhost:5000/api

# --- Google sign-in -------------------------------------------------------
# Must match the backend's GOOGLE_CLIENT_ID, which verifies the resulting token.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- Microsoft sign-in (Azure MSAL) ---------------------------------------
# Consumed by src/config/authConfig.ts.
VITE_MICROSOFT_CLIENT_ID=your-azure-application-client-id
VITE_MICROSOFT_TENANT_ID=your-azure-directory-tenant-id

# --- Notes ----------------------------------------------------------------
# There is deliberately no VAPID variable here. The service worker fetches the
# Web Push public key from GET /api/notifications/push/public-key at
# subscription time, so the keys are configured in one place: the backend.
