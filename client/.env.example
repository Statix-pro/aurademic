# Frontend environment — copy to .env.development (and .env.production).
# Vite exposes only VITE_-prefixed values; never put secrets in this file.

# Leave unset in development to use Vite's same-origin /api and /uploads proxies.
# Set this only when the client must call a deployed API directly.
# VITE_API_URL=http://localhost:5000/api

# Google sign-in: must match the backend GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Microsoft sign-in (consumed by src/config/authConfig.ts).
VITE_MICROSOFT_CLIENT_ID=your-azure-application-client-id
VITE_MICROSOFT_TENANT_ID=your-azure-directory-tenant-id

# No VAPID variable is needed: the service worker obtains its public key from
# GET /api/notifications/push/public-key at subscription time.
